# Smart Games - zmienne środowiskowe
# Skopiuj do pliku .env w katalogu głównym projektu: cp .env.example .env
# Plik .env jest czytany przez docker-compose.yml. Nie commituj go do repozytorium.

# --- PostgreSQL ---
POSTGRES_USER=smartgames
POSTGRES_PASSWORD=zmien_to_haslo
POSTGRES_DB=smartgames

# --- Backend (API) ---
# Adres frontendu, dopuszczony w CORS (bez ukośnika na końcu)
FRONT_URL=http://localhost:3001
# Sekret do podpisywania access tokenów JWT, min. 32 losowe znaki
# Przykład generowania: openssl rand -hex 32
JWT_ACCESS_SECRET=zmien_na_dlugi_losowy_ciag

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=zmien_to_haslo

# --- Opcjonalne: uruchamianie bez Dockera ---
# Przy docker compose poniższe wartości są ustawiane automatycznie w docker-compose.yml.
# Odkomentuj je tylko przy lokalnym starcie API (smart-games-api/.env).
# DATABASE_URL=postgresql://smartgames:zmien_to_haslo@localhost:5432/smartgames?schema=public
# PORT=3000
# NODE_ENV=development
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Opcjonalne: frontend bez Dockera (smart-games-front/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:3000
