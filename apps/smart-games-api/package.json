{
	"name": "smart-games-api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "pnpm run build:packages && nest build",
		"format": "pnpm --dir ../.. exec prettier --write apps/smart-games-api",
		"start": "pnpm run build:packages && nest start",
		"start:dev": "pnpm run build:packages && nest start --watch",
		"start:debug": "pnpm run build:packages && nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint .",
		"test": "pnpm run build:packages && jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "pnpm run build:packages && jest --config ./test/jest-e2e.json",
		"lint:fix": "eslint . --fix",
		"build:packages": "pnpm --filter @smart-games/xp... run build",
		"test:integration": "pnpm build && node --test test/games.integration.cjs",
		"test:games": "pnpm run build:packages && jest --runInBand src/pvp/pvp.gateway.spec.ts src/sudoku/test/sudoku.service.spec.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/platform-socket.io": "^11.1.21",
		"@nestjs/swagger": "^11.4.3",
		"@nestjs/websockets": "^11.1.21",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@scalar/nestjs-api-reference": "^1.1.14",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.4.2",
		"ioredis": "^5.10.1",
		"pg": "^8.20.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3",
		"@smart-games/xp": "workspace:*",
		"@smart-games/game-engine": "workspace:*"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.10.7",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"jest": "^30.0.0",
		"prisma": "^7.8.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1",
			"^prisma/(.*)$": "<rootDir>/../prisma/$1",
			"^generated/(.*)$": "<rootDir>/../generated/$1",
			"^(\\.{1,2}/.*)\\.js$": "$1"
		}
	}
}
